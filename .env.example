# Boş bırakılırsa istekler Vite proxy üzerinden gider (/api → Laravel).
# LAN erişimi için önerilen ayar budur.
# Doğrudan API'ye bağlanmak için örn.: http://192.168.1.42:8001/api/v1
# Production (Coolify): admin uygulamasının public API kökü, örn.:
# VITE_API_BASE_URL=https://admin.yourdomain.com/api/v1
# VITE_API_BASE_URL=

# Laravel adresi (yalnızca Vite proxy hedefi; tarayıcı görmez)
VITE_API_PROXY_TARGET=http://127.0.0.1:8001
